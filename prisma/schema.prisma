generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  industry       String   @default("other")
  company        String?
  avatarUrl      String?
  plan                 String   @default("free")
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  emailVerified        Boolean  @default(false)
  onboarded      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  photos                  Photo[]
  voiceSamples            VoiceSample[]
  videos                  Video[]
  schedules               Schedule[]
  socialAccounts          SocialAccount[]
  brandProfile            BrandProfile?
  analytics               AnalyticsEvent[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  characterSheets         CharacterSheet[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model BrandProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName      String?
  tagline        String?
  toneOfVoice    String?
  targetAudience String?
  competitors    String?
  brandColors    String?
  guidelines     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Photo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  videos Video[]

  @@index([userId])
}

model VoiceSample {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  duration  Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  videos Video[]

  @@index([userId])
}

model Video {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  script        String?
  status        String   @default("draft")
  model         String   @default("kling_2.6")
  videoUrl      String?
  thumbnailUrl  String?
  duration      Int      @default(0)
  contentType   String   @default("general")
  sourceReview  String?
  photoId       String?
  photo         Photo?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  voiceId       String?
  voice         VoiceSample? @relation(fields: [voiceId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  schedule        Schedule?
  analyticsEvents AnalyticsEvent[]

  @@index([userId])
  @@index([status])
  @@index([contentType])
  @@index([photoId])
  @@index([voiceId])
}

model Schedule {
  id          String    @id @default(uuid())
  videoId     String    @unique
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String
  scheduledAt DateTime
  publishedAt DateTime?
  status      String    @default("scheduled")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model SocialAccount {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  handle       String
  connected    Boolean   @default(true)
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  accountId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  eventType String
  platform  String?
  count     Int      @default(1)
  date      DateTime @default(now())

  @@index([userId])
  @@index([videoId])
  @@index([eventType])
  @@index([userId, eventType])
}

// ─── Character Sheets ───────────────────────────────────────────

model CharacterSheet {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // "poses" | "3d_360"
  compositeUrl String?
  status       String   @default("generating") // generating | complete | failed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images CharacterSheetImage[]

  @@index([userId])
}

model CharacterSheetImage {
  id               String         @id @default(uuid())
  characterSheetId String
  characterSheet   CharacterSheet @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)
  url              String
  position         Int
  angle            String?
  createdAt        DateTime       @default(now())

  @@index([characterSheetId])
}

// ─── System Configuration ───────────────────────────────────────

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  label     String
  category  String   // "models" | "prompts" | "onboarding"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
